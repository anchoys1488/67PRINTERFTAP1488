local function getPlotOwner(plotName)
    local plotsFolder = Workspace:FindFirstChild("Plots")
    if not plotsFolder then return nil end
    local plot = plotsFolder:FindFirstChild(plotName)
    if not plot then return nil end
    local sign = plot:FindFirstChild("PlotSign")
    if not sign then return nil end
    local owners = sign:FindFirstChild("ThisPlotsOwners")
    if not owners then return nil end
    for _, d in ipairs(owners:GetDescendants()) do
        if d.Name == "TimeRemainingNum" and d.Parent:IsA("StringValue") and d.Parent.Value ~= "" then
            return d.Parent.Value
        end
    end
    return nil
end

local function checkMyPlot()
    for i = 1, 5 do
        local plot = Workspace.Plots:FindFirstChild("Plot"..i)
        if plot then
            local sign = plot:FindFirstChild("PlotSign")
            if sign then
                for _, desc in ipairs(sign:GetDescendants()) do
                    if desc.Name == "TimeRemainingNum" then
                        local valObj = desc.Parent
                        if valObj and valObj:IsA("StringValue") and valObj.Value == Player.Name then
                            return plot
                        end
                    end
                end
            end
        end
    end
    return nil
end

local function isAntiKickAttached()
    local myPlot = checkMyPlot()
    if not myPlot then return false end
    local plotItems = Workspace:FindFirstChild("PlotItems")
    if not plotItems then return false end
    local myPlotFolder = plotItems:FindFirstChild(myPlot.Name)
    if not myPlotFolder then return false end
    for _, item in ipairs(myPlotFolder:GetChildren()) do
        if item.Name == "AntiKick" or item.Name == "NinjaShuriken" then
            local sp = item:FindFirstChild("StickyPart")
            if sp and sp:IsA("BasePart") and sp.CanTouch == false then
                return true
            end
        end
    end
    return false
end

local function toggleByName(name, value)
    if not (BO and BO.Flags) then return false end
    for _, flag in pairs(BO.Flags) do
        if flag.Name == name then
            pcall(function() flag:Set(value) end)
            return true
        end
    end
    return false
end

local function deleteMyAntiKicks()
    local destroyRem = RS:FindFirstChild("MenuToys") and RS.MenuToys:FindFirstChild("DestroyToy")
    if not destroyRem then return 0 end
    local n = 0
    local plotItems = Workspace:FindFirstChild("PlotItems")
    if plotItems then
        for i = 1, 5 do
            local pFolder = plotItems:FindFirstChild("Plot"..i)
            if pFolder then
                for _, item in ipairs(pFolder:GetChildren()) do
                    if item.Name == "AntiKick" or item.Name == "NinjaShuriken" then
                        pcall(function() destroyRem:FireServer(item) end)
                        n = n + 1
                    end
                end
            end
        end
    end
    local mySpawned = Workspace:FindFirstChild(Player.Name .. "SpawnedInToys")
    if mySpawned then
        for _, item in ipairs(mySpawned:GetChildren()) do
            if item.Name == "AntiKick" or item.Name == "NinjaShuriken" then
                pcall(function() destroyRem:FireServer(item) end)
                n = n + 1
            end
        end
    end
    return n
end

