local function doAutoAntiKick()
    resetBusyFlags()
    AutoAKBusy = true
    BusySetTime = tick()

    local result = false
    local success, err = pcall(function()
        notify("Auto AK", "Restoring...", 2)
        local owner = getPlotOwner("Plot1")
        if owner ~= Player.Name then
            if owner and owner ~= "" then
                notify("Auto AK", "Plot1 taken", 3)
                return
            else
                claimPlot("Plot1")
                task.wait(0.5)
            end
        end
        if getPlotOwner("Plot1") ~= Player.Name then
            return
        end
        tpToPlot()
        task.wait(0.5)
        restartTheWorstAntiKick()
        task.wait(4)
        if isAntiKickAttached() then
            AntiKickWasSet = true
            notify("Auto AK", "Restored!", 2)
            result = true
        end
    end)

    resetBusyFlags()

    if not success then
        notify("Auto AK", "Error: " .. tostring(err), 3)
    end

    return result
end

