    Title.Text = "AntiKick"
    Title.TextColor3 = Color3.fromRGB(255, 255, 255)
    Title.TextSize = 14
    Title.Font = Enum.Font.GothamBold
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Parent = Header

    local ToggleBtn = Instance.new("TextButton")
    ToggleBtn.Name = "ToggleBtn"
    ToggleBtn.Size = UDim2.new(0, 26, 0, 26)
    ToggleBtn.Position = UDim2.new(1, -32, 0, 6)
    ToggleBtn.BackgroundTransparency = 1
    ToggleBtn.Text = "−"
    ToggleBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    ToggleBtn.TextSize = 20
    ToggleBtn.Font = Enum.Font.GothamBold
    ToggleBtn.Parent = Header

    ToggleBtn.MouseEnter:Connect(function()
        ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end)
    ToggleBtn.MouseLeave:Connect(function()
        ToggleBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    end)

    local Body = Instance.new("Frame")
    Body.Name = "Body"
    Body.Size = UDim2.new(1, 0, 0, 92)
    Body.Position = UDim2.new(0, 0, 0, 46)
    Body.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    Body.BackgroundTransparency = 0.55
    Body.BorderSizePixel = 0
    Body.Parent = Root

    local BCorner = Instance.new("UICorner")
    BCorner.CornerRadius = UDim.new(0, 18)
    BCorner.Parent = Body

    local Padding = Instance.new("UIPadding")
    Padding.PaddingTop = UDim.new(0, 9)
    Padding.PaddingBottom = UDim.new(0, 9)
    Padding.PaddingLeft = UDim.new(0, 12)
    Padding.PaddingRight = UDim.new(0, 12)
    Padding.Parent = Body

    local Layout = Instance.new("UIListLayout")
    Layout.SortOrder = Enum.SortOrder.LayoutOrder
    Layout.Padding = UDim.new(0, 6)
    Layout.Parent = Body

    local function makeButton(name, order, callback, isToggle)
        local Btn = Instance.new("TextButton")
        Btn.Name = name
        Btn.Size = UDim2.new(1, 0, 0, 32)
        Btn.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
        Btn.BackgroundTransparency = 1
        Btn.BorderSizePixel = 0
        Btn.Text = name
        Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        Btn.TextSize = 13
        Btn.Font = Enum.Font.GothamMedium
        Btn.LayoutOrder = order
        Btn.AutoButtonColor = false
        Btn.Parent = Body

        local BtnCorner = Instance.new("UICorner")
        BtnCorner.CornerRadius = UDim.new(0, 12)
        BtnCorner.Parent = Btn

        local BtnStroke = Instance.new("UIStroke")
        BtnStroke.Color = Color3.fromRGB(0, 0, 0)
        BtnStroke.Thickness = 1
        BtnStroke.Transparency = 0.2
        BtnStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        BtnStroke.Parent = Btn

        if not isToggle then
            Btn.MouseEnter:Connect(function()
                Btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                Btn.BackgroundTransparency = 0.9
            end)
            Btn.MouseLeave:Connect(function()
                Btn.BackgroundTransparency = 1
            end)
        end

        Btn.MouseButton1Click:Connect(callback)
        return Btn, BtnStroke
    end

    makeButton("AntiKick FH", 1, function()
        task.spawn(antiKickFH)
    end)

    local AutoBtn, AutoBtnStroke = makeButton("Auto AntiKick FH", 2, function()
        AutoAntiKick = not AutoAntiKick
        if AutoAntiKick then
            resetBusyFlags()
            if isAntiKickAttached() then
                AntiKickWasSet = true
            end
            notify("Auto AK", "Enabled", 2)
        else
            notify("Auto AK", "Disabled", 2)
        end
    end, true)

    local function updateAutoBtnColor()
        if AutoAntiKick then
            AutoBtn.BackgroundColor3 = Color3.fromRGB(60, 200, 90)
            AutoBtn.BackgroundTransparency = 0.55
            AutoBtnStroke.Color = Color3.fromRGB(30, 120, 50)
        else
            AutoBtn.BackgroundTransparency = 1
            AutoBtnStroke.Color = Color3.fromRGB(0, 0, 0)
        end
    end

    AutoBtn.MouseEnter:Connect(function()
        if AutoAntiKick then
            AutoBtn.BackgroundTransparency = 0.4
        else
            AutoBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            AutoBtn.BackgroundTransparency = 0.9
        end
    end)
    AutoBtn.MouseLeave:Connect(function()
        updateAutoBtnColor()
    end)

    task.spawn(function()
        while ScreenGui.Parent do
            updateAutoBtnColor()
            task.wait(0.3)
        end
    end)

    local isCollapsed = false
    local expandedRoot = UDim2.new(0, 200, 0, 140)
    local collapsedRoot = UDim2.new(0, 200, 0, 38)

    ToggleBtn.MouseButton1Click:Connect(function()
        isCollapsed = not isCollapsed
        if isCollapsed then
            Body.Visible = false
            Root.Size = collapsedRoot
            ToggleBtn.Text = "+"
        else
            Body.Visible = true
            Root.Size = expandedRoot
            ToggleBtn.Text = "−"
        end
    end)

    local dragging = false
    local dragStart = nil
    local startPos = nil
    local targetPos = nil

    Header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = Root.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            targetPos = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    RunService.RenderStepped:Connect(function(dt)
        if targetPos and Root and Root.Parent then
            local cur = Root.Position
            local lerpFactor = math.min(dt * 15, 1)
            local newX = cur.X.Offset + (targetPos.X.Offset - cur.X.Offset) * lerpFactor
            local newY = cur.Y.Offset + (targetPos.Y.Offset - cur.Y.Offset) * lerpFactor
            Root.Position = UDim2.new(
                targetPos.X.Scale, newX,
                targetPos.Y.Scale, newY
            )
        end
    end)
end

