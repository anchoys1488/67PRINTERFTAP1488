local function hamburgerTeleport()
    local char = Player.Character or Player.CharacterAdded:Wait()
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local originalCFrame = hrp.CFrame
    local MenuToys = RS:FindFirstChild("MenuToys")
    local SpawnToyRemoteFunction = MenuToys and MenuToys:FindFirstChild("SpawnToyRemoteFunction")
    if not SpawnToyRemoteFunction then return false end
    pcall(function()
        SpawnToyRemoteFunction:InvokeServer(ToyName, hrp.CFrame, Vector3.zero)
    end)
    local spawnedToys = Workspace:FindFirstChild(Player.Name .. "SpawnedInToys")
    if not spawnedToys then return false end
    local toy = spawnedToys:WaitForChild(ToyName, 5)
    if not toy then return false end
    local HoldPart = toy:FindFirstChild("HoldPart")
    local HoldItemRemoteFunction = HoldPart and HoldPart:FindFirstChild("HoldItemRemoteFunction")
    if not HoldItemRemoteFunction then
        local DestroyToy = MenuToys and MenuToys:FindFirstChild("DestroyToy")
        if DestroyToy then pcall(function() DestroyToy:FireServer(toy) end) end
        return false
    end
    pcall(function() HoldItemRemoteFunction:InvokeServer(toy, char) end)
    local plotsFolder = Workspace:FindFirstChild("Plots")
    local plot = plotsFolder and plotsFolder:FindFirstChild(TargetPlot)
    local plotArea = plot and plot:FindFirstChild("PlotArea")
    if not plotArea then
        local DestroyToy = MenuToys and MenuToys:FindFirstChild("DestroyToy")
        if DestroyToy then pcall(function() DestroyToy:FireServer(toy) end) end
        return false
    end
    hrp.CFrame = plotArea.CFrame
    task.wait(TPDelay)
    hrp.CFrame = originalCFrame
    local DestroyToy = MenuToys and MenuToys:FindFirstChild("DestroyToy")
    if DestroyToy then pcall(function() DestroyToy:FireServer(toy) end) end
    return true
end

local function detectBarrier()
    if DetectRunning then notify("Detect", "Already running", 2) return end
    DetectRunning = true
    local plotsFolder = Workspace:FindFirstChild("Plots")
    local plot = plotsFolder and plotsFolder:FindFirstChild(TargetPlot)
    local plotArea = plot and plot:FindFirstChild("PlotArea")
    if not plotArea then DetectRunning = false notify("Detect", "No PlotArea", 3) return end
    local MenuToys = RS:FindFirstChild("MenuToys")
    local SpawnRemote = MenuToys and MenuToys:FindFirstChild("SpawnToyRemoteFunction")
    local DestroyToy = MenuToys and MenuToys:FindFirstChild("DestroyToy")
    if not SpawnRemote then DetectRunning = false return end
    local spawnedFolder = Workspace:FindFirstChild(Player.Name .. "SpawnedInToys")
    if not spawnedFolder then DetectRunning = false return end
    local existingItems = {}
    for _, it in ipairs(spawnedFolder:GetChildren()) do existingItems[it] = true end
    local spawnCF = plotArea.CFrame * CFrame.new(0, -plotArea.Size.Y/2 + 5, 0)
    pcall(function() SpawnRemote:InvokeServer(ToyName, spawnCF, Vector3.new()) end)
    local testItem = nil
    local waitStart = tick()
    while tick() - waitStart < 2 do
        for _, it in ipairs(spawnedFolder:GetChildren()) do
            if not existingItems[it] and it.Name == ToyName then testItem = it break end
        end
        if testItem then break end
        task.wait(0.02)
    end
    if not testItem then DetectRunning = false notify("Detect", "Spawn failed", 3) return end
    task.wait(DetectWaitTime)
    local stillExists = testItem and testItem.Parent ~= nil
    if stillExists then
        BarrierBroken = true
        if DestroyToy then pcall(function() DestroyToy:FireServer(testItem) end)
        else pcall(function() testItem:Destroy() end) end
        notify("Detector", TargetPlot .. ": BROKEN", 3)
    else
        BarrierBroken = false
        notify("Detector", TargetPlot .. ": ACTIVE", 3)
    end
    DetectRunning = false
end

local function claimPlot(plotName)
    plotName = plotName or TargetPlot
    local plotsFolder = Workspace:FindFirstChild("Plots")
    local plot = plotsFolder and plotsFolder:FindFirstChild(plotName)
    if not plot then notify("Claim", "Plot not found", 3) return false end
    local sign = plot:FindFirstChild("PlotSign")
    if not sign then notify("Claim", "PlotSign not found", 3) return false end
    local grabPart = nil
    for _, d in ipairs(sign:GetDescendants()) do
        if d:IsA("BasePart") and d.Name == "PlusGrabPart" then grabPart = d break end
    end
    if not grabPart then notify("Claim", "PlusGrabPart not found", 3) return false end
    local char = Player.Character or Player.CharacterAdded:Wait()
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not hrp or not hum then notify("Claim", "No character", 3) return false end
    if hum.Sit then hum.Sit = false end
    hrp.CFrame = grabPart.CFrame * CFrame.new(0, 3, 0)
    hrp.Velocity = Vector3.zero
    task.wait(0.2)
    local SetNetOwner = RS:FindFirstChild("GrabEvents") and RS.GrabEvents:FindFirstChild("SetNetworkOwner")
    if not SetNetOwner then notify("Claim", "SetNetworkOwner not found", 3) return false end
    local claimStart = tick()
    local claimed = false
    while tick() - claimStart < 5 do
        pcall(function() SetNetOwner:FireServer(grabPart, grabPart.CFrame) end)
        task.wait(0.1)
        local owner = getPlotOwner(plotName)
        if owner == Player.Name then claimed = true break end
    end
    if claimed then
        notify("Claim", "Claimed " .. plotName, 3)
    else
        notify("Claim", "Timeout", 3)
    end
    return claimed
end

local function tpToPlot()
    local plotsFolder = Workspace:FindFirstChild("Plots")
    local plot = plotsFolder and plotsFolder:FindFirstChild(TargetPlot)
    if not plot then return end
    local sign = plot:FindFirstChild("PlotSign")
    local grabPart = nil
    if sign then
        for _, d in ipairs(sign:GetDescendants()) do
            if d:IsA("BasePart") and d.Name == "PlusGrabPart" then grabPart = d break end
        end
    end
    local ref = grabPart or plot:FindFirstChild("PlotArea")
    if not ref then return end
    local char = Player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    if not hrp then return end
    if hum and hum.Sit then hum.Sit = false end
    hrp.CFrame = ref.CFrame * CFrame.new(0, 3, 0)
    hrp.Velocity = Vector3.zero
end

