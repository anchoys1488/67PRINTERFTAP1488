local Enabled = true
local MaxHistory = 10

-- Detector
local DetectorEnabled = true
local Threshold = 70              -- грабов
local TimeWindow = 1              -- за сколько секунд

-- Notify
local NotifyCooldown = 1          -- раз в сколько секунд
local NotifyDuration = 5          -- длительность уведомления

local touchHistory = {}
local kickEvents = {}
local lastNotify = {}
local currentToucher = nil

-- =========================================
local lastToucherLabel = Sect.HistorySection:AddLabel("Last: none")
local historyParagraph = Sect.HistorySection:AddParagraph("History", "empty")

local function refreshUI()
    if #touchHistory == 0 then
        lastToucherLabel:Set("Last: none")
        historyParagraph:Set("empty")
        return
    end
    lastToucherLabel:Set("Last: " .. touchHistory[1].display)
    local text = ""
    for i, e in ipairs(touchHistory) do
        text = text .. i .. ". " .. e.display .. " x" .. e.count .. "\n"
    end
    historyParagraph:Set(text)
end

local function notify(playerName)
    local plr = Players:FindFirstChild(playerName)
    local displayName = plr and plr.DisplayName or playerName
    local content = displayName .. " (" .. playerName .. ")\n" .. Threshold .. " hits / " .. TimeWindow .. "s"

    if BO and BO.MakeNotification then
        pcall(function()
            BO:MakeNotification({
                Name = "Kick Notify",
                Content = content,
                Image = "alert-triangle",
                Time = NotifyDuration
            })
        end)
    else
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Kick Notify",
                Text = content,
                Duration = NotifyDuration
            })
        end)
    end
end

-- =========================================
local function checkKick(playerName)
    if not DetectorEnabled then return end
    if not playerName or playerName == "" then return end
    if playerName == LocalPlayer.Name then return end

    local now = tick()
    if not kickEvents[playerName] then kickEvents[playerName] = {} end
    table.insert(kickEvents[playerName], now)

    local list = kickEvents[playerName]
    while #list > 0 and (now - list[1]) > TimeWindow do
        table.remove(list, 1)
    end

    if #list >= Threshold then
        if not lastNotify[playerName] or (now - lastNotify[playerName]) >= NotifyCooldown then
            lastNotify[playerName] = now
            notify(playerName)
        end
    end
end

local function registerToucher(playerName)
    if not Enabled then return end
    if not playerName or playerName == "" then return end
    if playerName == LocalPlayer.Name then return end

    currentToucher = playerName

    local plr = Players:FindFirstChild(playerName)
    local displayName = plr and plr.DisplayName or playerName
    local display = displayName .. " (" .. playerName .. ")"

    if touchHistory[1] and touchHistory[1].name == playerName then
        touchHistory[1].count = touchHistory[1].count + 1
    else
        table.insert(touchHistory, 1, {name = playerName, display = display, count = 1})
    end
    while #touchHistory > MaxHistory do table.remove(touchHistory) end
    refreshUI()

    -- Каждое касание идёт в детектор
    checkKick(playerName)
end

-- =========================================
local function extractName(val)
    if typeof(val) == "Instance" and val:IsA("Player") then return val.Name
    elseif typeof(val) == "string" and val ~= "" then return val end
    return nil
end

local connections = {}
local function clearConn()
    for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
    connections = {}
end

local function hookChar(char)
    clearConn()
    if not char then return end

    local head = char:WaitForChild("Head", 5)
    if not head then return end

    local function hookPO(po)
        local name = extractName(po.Value)
        if name then registerToucher(name) end
        table.insert(connections, po:GetPropertyChangedSignal("Value"):Connect(function()
            local n = extractName(po.Value)
            if n then registerToucher(n) end
        end))
    end

    for _, c in ipairs(head:GetChildren()) do
        if c.Name == "PartOwner" then hookPO(c) end
    end

    table.insert(connections, head.ChildAdded:Connect(function(c)
        if c.Name == "PartOwner" then
            task.wait()
            hookPO(c)
        end
    end))
end

if LocalPlayer.Character then hookChar(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(hookChar)

